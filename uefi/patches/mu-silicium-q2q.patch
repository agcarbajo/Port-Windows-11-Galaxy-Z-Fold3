+STATIC
+VOID
+Q2qPublishSocInfoDiagnostic (VOID)
+{
+  EFI_GUID Guid = {0x7d7a1223, 0x2c79, 0x4d70, {0xb3, 0x5c, 0x80, 0x8f, 0xce, 0x6a, 0x10, 0x27}};
+  struct {
+    UINT32 Magic;
+    UINT32 Version;
+    UINT64 ItemAddress;
+    UINT64 SosiValue;
+    UINT64 SmemStatus;
+    UINT64 TableStatus;
+    UINT32 ItemSize;
+    UINT32 Flags;
+  } Data = {0};
+  EFI_SMEM_PROTOCOL *Smem;
+  EFI_ACPI_DESCRIPTION_HEADER *Table = NULL;
+  VOID *Item = NULL;
+  EFI_STATUS Status;
+  UINTN Handle;
+  UINTN Index;
+  UINTN Matches = 0;
+  UINT8 *Bytes;
+  UINT8 Sum = 0;
+
+  if (AsciiStrCmp ((CONST CHAR8 *)PcdGetPtr (PcdSmbiosSystemRetailModel), "q2q") != 0) {
+    return;
+  }
+  Data.Magic = 0x31435351;
+  Data.Version = 1;
+  Status = gBS->LocateProtocol (&gEfiSMEMProtocolGuid, NULL, (VOID **)&Smem);
+  if (!EFI_ERROR (Status)) {
+    Status = Smem->GetFunc (137, &Data.ItemSize, &Item);
+  }
+  Data.SmemStatus = (UINT64)Status;
+  Data.ItemAddress = (UINT64)(UINTN)Item;
+  if (!EFI_ERROR (Status)) {
+    Data.Flags |= 1U;
+  }
+  if ((Data.ItemAddress >= 0x80900000ULL) &&
+      (Data.ItemAddress < 0x80B00000ULL) &&
+      (Data.ItemSize >= 176) &&
+      (Data.ItemSize <= 0x80B00000ULL - Data.ItemAddress)) {
+    Data.Flags |= 2U;
+  }
+  Status = LocateTableBySignature (EFI_ACPI_3_0_DIFFERENTIATED_SYSTEM_DESCRIPTION_TABLE_SIGNATURE, &Table, &Handle);
+  Data.TableStatus = (UINT64)Status;
+  if (!EFI_ERROR (Status)) {
+    if ((Table->Length >= sizeof (*Table)) && (Table->Length <= 4096)) {
+      Bytes = (UINT8 *)Table;
+      for (Index = 0; Index < Table->Length; Index++) {
+        Sum = (UINT8)(Sum + Bytes[Index]);
+      }
+      if (Sum == 0) {
+        Data.Flags |= 4U;
+      }
+      for (Index = sizeof (*Table); Index + 14 <= Table->Length; Index++) {
+        if ((Bytes[Index] == 0x08) && (Bytes[Index + 1] == 'S') &&
+            (Bytes[Index + 2] == 'O') && (Bytes[Index + 3] == 'S') &&
+            (Bytes[Index + 4] == 'I') && (Bytes[Index + 5] == 0x0E)) {
+          Matches++;
+          Data.SosiValue = ReadUnaligned64 ((CONST UINT64 *)(Bytes + Index + 6));
+        }
+      }
+      if (Matches == 1) {
+        Data.Flags |= 8U;
+        if ((Data.Flags & 3U) == 3U && Data.SosiValue == Data.ItemAddress) {
+          Data.Flags |= 16U;
+        }
+      }
+    }
+    FreePool (Table);
+  }
+  Status = gRT->SetVariable (L"Q2qSocInfoDiag", &Guid,
+             EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS,
+             sizeof (Data), &Data);
+  if (gST->ConOut != NULL) {
+    Print (L"Q2Q SOCINFO RO: GET=%lx TABLE=%lx SIZE=%u FLAGS=%x\n",
+           Data.SmemStatus, Data.TableStatus, Data.ItemSize, Data.Flags);
+    Print (L"Q2Q SOCINFO RO: ITEM=%016lx SOSI=%016lx VAR=%r\n",
+           Data.ItemAddress, Data.SosiValue, Status);
+  }
+}
