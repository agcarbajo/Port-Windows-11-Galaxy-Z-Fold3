+STATIC
+VOID
+Q2qPublishGicDiagnostic (VOID)
+{
+  EFI_GUID Guid = {0xe6e1c119, 0x4d0a, 0x4b5c, {0x96, 0x9c, 0x42, 0x49, 0xde, 0x82, 0xfb, 0xfa}};
+  struct {
+    UINT32 Magic;
+    UINT32 Version;
+    UINT64 Distributor;
+    UINT32 Typer;
+    UINT32 MaxSpi;
+    UINT32 MaxExtSpi;
+    UINT32 IpccMask;
+  } Data;
+  CONST UINT32 Irqs[] = {0x105, 0x106, 0x107, 0x384};
+  EFI_STATUS Status;
+  UINTN Index;
+
+  if ((AsciiStrCmp ((CONST CHAR8 *)PcdGetPtr (PcdSmbiosSystemRetailModel), "q2q") != 0) ||
+      (PcdGet64 (PcdGicDistributorBase) != 0x17A00000)) {
+    return;
+  }
+  Data.Magic = 0x44473251;
+  Data.Version = 1;
+  Data.Distributor = PcdGet64 (PcdGicDistributorBase);
+  Data.Typer = MmioRead32 ((UINTN)Data.Distributor + ARM_GIC_ICDICTR);
+  Data.MaxSpi = (UINT32)ARM_GIC_ICDICTR_GET_SPI_MAX_INTID (Data.Typer);
+  Data.MaxExtSpi = (Data.Typer & ARM_GIC_ICDICTR_EXT_SPI_ENABLED) ?
+                  (UINT32)ARM_GIC_ICDICTR_GET_EXT_SPI_MAX_INTID (Data.Typer) : 0;
+  Data.IpccMask = 0;
+  for (Index = 0; Index < sizeof (Irqs) / sizeof (Irqs[0]); Index++) {
+    if (Irqs[Index] <= Data.MaxSpi) {
+      Data.IpccMask |= (UINT32)(1U << Index);
+    }
+  }
+  Status = gRT->SetVariable (L"Q2qGicDiag", &Guid,
+             EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS,
+             sizeof (Data), &Data);
+  if (gST->ConOut != NULL) {
+    Print (L"Q2Q GIC READ-ONLY: TYPER=%08x MAX_SPI=%u MAX_EXT=%u IPCC_MASK=%x VAR=%r\n",
+           Data.Typer, Data.MaxSpi, Data.MaxExtSpi, Data.IpccMask, Status);
+  }
+}
