+STATIC
+BOOLEAN
+Q2qTouchPowerAllowed (UINT8 IoConfig, UINT8 AnalogConfig, UINT8 Enable)
+{
+  return ((1500000U + (IoConfig & 31U) * 25000U) == 1800000U) &&
+         ((2700000U + (AnalogConfig & 63U) * 25000U) == 3000000U) &&
+         ((Enable & 0x19U) == 0x19U);
+}
