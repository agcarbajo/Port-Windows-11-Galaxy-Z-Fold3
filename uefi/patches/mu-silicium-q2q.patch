+STATIC
+VOID
+Q2qPublishCmdDbDiagnostic (VOID)
+{
+  EFI_GUID Guid = {0x13b49fe8, 0x7c4a, 0x4d71, {0x82, 0xb5, 0x9b, 0xb9, 0xae, 0x7c, 0x9e, 0x52}};
+  struct {
+    UINT32 Magic;
+    UINT32 Version;
+    UINT32 PublishedAddress;
+    UINT32 PublishedSize;
+    UINT32 Flags;
+    UINT32 DtVersion;
+    UINT32 DtMagic;
+    UINT32 PublishedVersion;
+    UINT32 PublishedMagic;
+    struct {
+      UINT32 Status;
+      UINT16 AuxVersion;
+      UINT16 AuxSize;
+    } Probes[3];
+    UINT32 Expected;
+    UINT32 Good;
+    UINT32 Missing;
+    UINT32 Bad;
+    UINT32 FirstIndex;
+    UINT32 FirstStatus;
+    UINT16 FirstAuxVersion;
+    UINT16 FirstAuxSize;
+  } Data = {0};
+  CONST CHAR8 Names[3][8] = {"smpb5", "smpb11", "ldob1"};
+  CONST CHAR8 PppNames[50][8] = {
+    "smpb5", "smpb6", "smpb9", "smpb10",
+    "smpc1", "smpc2", "smpc3", "smpc4", "smpc6", "smpc8", "smpc10",
+    "smpe1", "smpe2", "smpe3", "ldob1", "ldob2", "ldob3", "ldob4",
+    "ldoc1", "ldoc2", "ldoc3", "ldoc4", "ldoc5", "ldoc6", "ldoc7", "ldoc8", "ldoc9",
+    "ldoc10", "ldoc11", "ldoc12", "ldoc13",
+    "ldoe1", "ldoe2", "ldoe3", "ldoe4", "ldoe5", "ldoe6", "ldoe7",
+    "lnbclka2", "rfclka1", "rfclka2", "bobc1",
+    "ldob5", "ldob6", "ldob7", "ldob8", "ldob9", "ldod1", "smpb11", "smpb12"
+  };
+  CONST UINT16 PppIds[50] = {
+    24, 25, 28, 29, 30, 31, 32, 33, 35, 37, 39, 40, 41, 42, 89, 90, 91, 92,
+    93, 94, 95, 96, 97, 98, 99, 100, 101, 102, 103, 104, 105,
+    111, 112, 113, 114, 115, 116, 117, 143, 145, 146, 208,
+    226, 227, 228, 229, 230, 252, 312, 313
+  };
+  CHAR8 FirstName[9] = "none";
+  UINT16 AuxVersion;
+  UINT16 AuxSize;
+  UINT32 Result;
+  CONST UINT8 *Bytes = (CONST UINT8 *)(UINTN)0x80860000;
+  EFI_STATUS Status;
+  UINTN Index;
+
+  if (AsciiStrCmp ((CONST CHAR8 *)PcdGetPtr (PcdSmbiosSystemRetailModel), "q2q") != 0) {
+    return;
+  }
+  Data.Magic = 0x31424443;
+  Data.Version = 2;
+  Data.Expected = 50;
+  Data.FirstIndex = 0xFFFFFFFFU;
+  Data.PublishedAddress = MmioRead32 (0x0C3F000C);
+  Data.PublishedSize = MmioRead32 (0x0C3F0010);
+  Data.DtVersion = ReadUnaligned32 ((CONST UINT32 *)Bytes);
+  Data.DtMagic = ReadUnaligned32 ((CONST UINT32 *)(Bytes + 4));
+  if ((Data.DtVersion == 1) && (Data.DtMagic == 0x0C0330DB)) {
+    Data.Flags |= 1U;
+  }
+  if ((Data.PublishedAddress >= 0x80860000U) && (Data.PublishedAddress < 0x80880000U) &&
+      (Data.PublishedSize >= 144) && (Data.PublishedSize <= 0x80880000U - Data.PublishedAddress)) {
+    Data.Flags |= 2U;
+    Bytes = (CONST UINT8 *)(UINTN)Data.PublishedAddress;
+    Data.PublishedVersion = ReadUnaligned32 ((CONST UINT32 *)Bytes);
+    Data.PublishedMagic = ReadUnaligned32 ((CONST UINT32 *)(Bytes + 4));
+    if ((Data.PublishedVersion == 1) && (Data.PublishedMagic == 0x0C0330DB)) {
+      Data.Flags |= 4U;
+    }
+  }
+  if ((Data.PublishedAddress == 0x80860000U) && (Data.PublishedSize == 0x20000U)) {
+    Data.Flags |= 8U;
+  }
+  for (Index = 0; Index < 3; Index++) {
+    Data.Probes[Index].Status = Q2qCmdDbLookup ((CONST UINT8 *)(UINTN)0x80860000, 0x20000,
+                                Names[Index], &Data.Probes[Index].AuxVersion, &Data.Probes[Index].AuxSize);
+  }
+  for (Index = 0; Index < Data.Expected; Index++) {
+    AuxVersion = 0;
+    AuxSize = 0;
+    Result = ((Data.Flags & 6U) == 6U) ?
+      Q2qCmdDbLookup ((CONST UINT8 *)(UINTN)Data.PublishedAddress, Data.PublishedSize,
+        PppNames[Index], &AuxVersion, &AuxSize) : 4;
+    if (Result == 0) {
+      Data.Good++;
+    } else {
+      if (Result == 1) {
+        Data.Missing++;
+      } else {
+        Data.Bad++;
+      }
+      if (Data.FirstIndex == 0xFFFFFFFFU) {
+        UINTN Character;
+        Data.FirstIndex = PppIds[Index];
+        Data.FirstStatus = Result;
+        Data.FirstAuxVersion = AuxVersion;
+        Data.FirstAuxSize = AuxSize;
+        for (Character = 0; Character < 8; Character++) {
+          FirstName[Character] = PppNames[Index][Character];
+        }
+        FirstName[8] = 0;
+      }
+    }
+  }
+  Status = gRT->SetVariable (L"Q2qCmdDbDiag", &Guid,
+             EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS, sizeof (Data), &Data);
+  if (gST->ConOut != NULL) {
+    Print (L"Q2Q CMDDB RO: PUB=%08x SIZE=%x FLAGS=%x VAR=%r\n",
+           Data.PublishedAddress, Data.PublishedSize, Data.Flags, Status);
+    Print (L"Q2Q CMDDB RO: DT_VER=%u DT_MAGIC=%08x PUB_VER=%u PUB_MAGIC=%08x\n",
+           Data.DtVersion, Data.DtMagic, Data.PublishedVersion, Data.PublishedMagic);
+    for (Index = 0; Index < 3; Index++) {
+      Print (L"Q2Q CMDDB RO: %a STATUS=%u AUX_VER=%x AUX_SIZE=%u\n",
+             Names[Index], Data.Probes[Index].Status, Data.Probes[Index].AuxVersion, Data.Probes[Index].AuxSize);
+    }
+    Print (L"Q2Q PPP CMDDB: TOTAL=%u GOOD=%u MISS=%u BAD=%u\n",
+           Data.Expected, Data.Good, Data.Missing, Data.Bad);
+    Print (L"Q2Q PPP CMDDB: FIRST=%a ID=%u STATUS=%u VER=%x SIZE=%u\n",
+           FirstName, Data.FirstIndex, Data.FirstStatus, Data.FirstAuxVersion, Data.FirstAuxSize);
+  }
+}
 
