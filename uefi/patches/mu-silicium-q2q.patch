+STATIC
+UINT32
+Q2qCmdDbLookup (
+  CONST UINT8 *Bytes,
+  UINTN Size,
+  CONST CHAR8 *Name,
+  UINT16 *AuxVersion,
+  UINT16 *AuxSize)
+{
+  UINTN Slot;
+  UINTN Index;
+  UINTN Offset;
+  UINTN HeaderOffset;
+  UINTN DataOffset;
+  UINTN Count;
+  UINTN AuxOffset;
+  UINT64 Key;
+  UINT16 Version;
+
+  *AuxVersion = 0;
+  *AuxSize = 0;
+  if ((Size < 144) || (ReadUnaligned32 ((CONST UINT32 *)Bytes) != 1) ||
+      (ReadUnaligned32 ((CONST UINT32 *)(Bytes + 4)) != 0x0C0330DB)) {
+    return 4;
+  }
+  Key = ReadUnaligned64 ((CONST UINT64 *)Name);
+  for (Slot = 0; Slot < 8; Slot++) {
+    Offset = 8 + Slot * 16;
+    HeaderOffset = ReadUnaligned16 ((CONST UINT16 *)(Bytes + Offset + 2));
+    DataOffset = ReadUnaligned16 ((CONST UINT16 *)(Bytes + Offset + 4));
+    Count = ReadUnaligned16 ((CONST UINT16 *)(Bytes + Offset + 6));
+    Version = ReadUnaligned16 ((CONST UINT16 *)(Bytes + Offset + 8));
+    if ((HeaderOffset > Size - 144) || (Count > (Size - 144 - HeaderOffset) / 24)) {
+      return 2;
+    }
+    for (Index = 0; Index < Count; Index++) {
+      Offset = 144 + HeaderOffset + Index * 24;
+      if (ReadUnaligned64 ((CONST UINT64 *)(Bytes + Offset)) != Key) {
+        continue;
+      }
+      *AuxVersion = Version;
+      *AuxSize = ReadUnaligned16 ((CONST UINT16 *)(Bytes + Offset + 20));
+      AuxOffset = ReadUnaligned16 ((CONST UINT16 *)(Bytes + Offset + 22));
+      if ((DataOffset > Size - 144) || (AuxOffset > Size - 144 - DataOffset) ||
+          (*AuxSize > Size - 144 - DataOffset - AuxOffset)) {
+        return 2;
+      }
+      return ((Version >= 0x100) && (Version < 0x200) && (*AuxSize == 4)) ? 0 : 3;
+    }
+  }
+  return 1;
+}
