+STATIC
+__attribute__((noinline))
+UINT64
+Q2qWifiTranslate (UINTN Address, UINT32 *Level)
+{
+  UINT64 Current, Saved, Result = MAX_UINT64;
+  DEBUG ((DEBUG_ERROR, "Q2qWifi AT begin address=%lx\n", (UINT64)Address));
+  __asm__ __volatile__ ("mrs %0, CurrentEL" : "=r" (Current));
+  *Level = (UINT32)(Current >> 2);
+  if (*Level != 1 && *Level != 2) {
+    return Result;
+  }
+  __asm__ __volatile__ ("mrs %0, par_el1" : "=r" (Saved));
+  if (*Level == 1) {
+    __asm__ __volatile__ ("at s1e1r, %0" :: "r" (Address) : "memory");
+  } else {
+    __asm__ __volatile__ ("at s1e2r, %0" :: "r" (Address) : "memory");
+  }
+  __asm__ __volatile__ ("isb\n\tmrs %0, par_el1" : "=r" (Result) :: "memory");
+  __asm__ __volatile__ ("msr par_el1, %0\n\tisb" :: "r" (Saved) : "memory");
+  DEBUG ((DEBUG_ERROR, "Q2qWifi AT end address=%lx EL=%u PAR=%lx\n", (UINT64)Address, *Level, Result));
+  return Result;
+}
