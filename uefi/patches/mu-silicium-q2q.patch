+    Data.WriteEnable = Write ((UINT32)Channel, 0xc0, 3, Wanted);
+    if (Data.WriteEnable) {
+      goto Publish;
+    }
+    Data.ReadBack = Read ((UINT32)Channel, 0xc0, 3, &Data.After);
+    if (!Data.ReadBack && Data.After == Wanted) {
+      Data.Flags |= 64U;
+      gBS->Stall (20000);
+    }
+  }
+Publish:
+  Status = gRT->SetVariable (L"Q2qTouchPowerDiag", &DataGuid,
+             EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS,
+             sizeof (Data), &Data);
+  DEBUG ((EFI_D_ERROR, "Q2Q TOUCH POWER: flags=%x enable=%02x/%02x IO=%u AVDD=%u variable=%r\n",
+          Data.Flags, Data.Before, Data.After, Data.IoMicrovolts, Data.AnalogMicrovolts, Status));
+}
