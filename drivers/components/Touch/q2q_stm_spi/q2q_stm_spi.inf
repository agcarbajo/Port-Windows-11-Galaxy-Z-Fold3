[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%Provider%
DriverVer=10/06/2026,0.2.0.5
CatalogFile=q2q_stm_spi.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Q2Q,NTarm64.10.0...22000

[Q2Q.NTarm64.10.0...22000]
%DeviceDesc%=Q2qTouch,ACPI\STFT180F

[Q2qTouch.NT]
CopyFiles=DriverFiles
Include=MsHidKmdf.inf
Needs=MsHidKmdf.NT

[Q2qTouch.NT.HW]
AddReg=DeviceSettings
Include=MsHidKmdf.inf
Needs=MsHidKmdf.NT.HW

[Q2qTouch.NT.Services]
AddService=q2q_stm_spi,0,TouchService
Include=MsHidKmdf.inf
Needs=MsHidKmdf.NT.Services

[Q2qTouch.NT.Filters]
AddFilter=q2q_stm_spi,,TouchFilter

[TouchFilter]
FilterPosition=Lower

[Q2qTouch.NT.Wdf]
KmdfService=q2q_stm_spi,WdfSettings

[WdfSettings]
KmdfLibraryVersion=1.15

[DeviceSettings]
HKR,,XRevert,0x00010001,1
HKR,,YRevert,0x00010001,0
HKR,,XYExchange,0x00010001,1
HKR,,XMin,0x00010001,0
HKR,,XMax,0x00010001,4095
HKR,,YMin,0x00010001,0
HKR,,YMax,0x00010001,4095

[TouchService]
DisplayName=%DeviceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\q2q_stm_spi.sys

[DriverFiles]
q2q_stm_spi.sys

[DestinationDirs]
DriverFiles=13

[SourceDisksNames]
1=%DiskDesc%,,,

[SourceDisksFiles]
q2q_stm_spi.sys=1

[Strings]
Provider="Local q2q Bring-up"
DeviceDesc="q2q STM SPI Touchscreen"
DiskDesc="q2q STM SPI Touchscreen"
